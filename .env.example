# ====================================================
# VARIAVEIS DE AMBIENTE - FotoMagica WhatsApp Bot
# ====================================================
# INSTRUCOES PARA INICIANTES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores abaixo (NUNCA suba o .env para o GitHub!)
#   3. No Azure App Service, cadastre estas variaveis no painel:
#      App Service > Configuracoes > Variaveis de ambiente

# ----- MERCADO PAGO -----
# Onde obter: https://www.mercadopago.com.br/developers/panel
# Clique em "Suas credenciais" > "Credenciais de producao"
# O token comeca com APP_USR- (producao) ou TEST- (testes sem dinheiro real)
MERCADO_PAGO_TOKEN=SEU_ACCESS_TOKEN_AQUI

# ----- REPLICATE -----
# Onde obter: https://replicate.com/account/api-tokens
# Clique em "Create token"
REPLICATE_API_TOKEN=SEU_TOKEN_REPLICATE_AQUI

# ----- WEBHOOK PIX -----
# URL publica onde o Mercado Pago avisa sobre pagamentos aprovados
# No Azure App Service, sera algo como:
# https://fotomagica-bot.azurewebsites.net/webhook-pix
# Ou com seu dominio .tech:
# https://seudominio.tech/webhook-pix
WEBHOOK_PIX_URL=https://SEU-APP.azurewebsites.net/webhook-pix

# ----- AZURE: ARMAZENAMENTO PERSISTENTE -----
# Onde ficam o banco de dados e os arquivos de sessao do WhatsApp.
# No Azure App Service Linux, use: /home/data
# No seu PC local: deixe em branco (usa a pasta do projeto automaticamente)
DATA_DIR=/home/data

# ----- SERVIDOR -----
PORT=8080
