# ====================================================
# VARIAVEIS DE AMBIENTE - FotoMagica WhatsApp Bot
# ====================================================
# INSTRUCOES:
#   1. Copie este arquivo: cp .env.example .env
#   2. Preencha os valores REAIS abaixo (nunca suba o .env para o GitHub!)
#   3. No Railway, cadastre essas variaveis no painel do projeto

# ----- MERCADO PAGO -----
# Obtenha em: https://www.mercadopago.com.br/developers/panel
# Use o token de PRODUCAO (comeca com APP_USR-) para cobrar de verdade
# Use o token de TEST (comeca com TEST-) para testes sem dinheiro real
MERCADO_PAGO_TOKEN=SEU_ACCESS_TOKEN_AQUI

# ----- REPLICATE -----
# Obtenha em: https://replicate.com/account/api-tokens
REPLICATE_API_TOKEN=SEU_TOKEN_REPLICATE_AQUI

# ----- WEBHOOK PIX -----
# URL publica onde o Mercado Pago vai avisar sobre pagamentos
# Formato: https://SEU-DOMINIO.tech/webhook-pix
# No Railway, use a URL gerada automaticamente pelo deploy
WEBHOOK_PIX_URL=https://SEU-DOMINIO.tech/webhook-pix

# ----- SERVIDOR -----
PORT=3000
